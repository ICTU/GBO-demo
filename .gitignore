# Go binaries. `go build` in a service directory drops an extension-less
# binary there; the pattern below ignores those.
services/*/server
services/*/*[!.go]
!services/*/go.*
!services/*/Dockerfile
!services/*/main.go
# Web assets baked into a binary with go:embed — the binary-catching pattern
# above matches any filename not ending in `.go`, including these.
!services/*/*.html
!services/dev-portal-backend/rules.json
!services/openftv-pdp/field-map.json
# It matches directory names too, which silently swallowed the Go sub-packages
# under services/consent-portal-backend/. Keeping every service subdirectory
# covers that, and supersedes the per-directory exceptions this list used to
# need for mockdata/, scenarios/, config/ and openftv-pdp/mapper/.
!services/*/*/

# Local compose overrides + secrets
.env
.env.local
fsc-infra/.env
fsc-infra/.env.local
.local/

# Issuance-server runtime config carries inline demo signing keys +
# hostnames tied to the issuer/reader certs — never commit. Use the
# .example files as templates and run `make eudi-config` to bootstrap
# runtime copies from your local nl-wallet checkout.
services/eudi-issuance-server/config/issuance_server.toml
services/eudi-issuance-server/config/inkomensverklaring_metadata.json
services/eudi-issuance-server/config/akte_van_overlijden_metadata.json
services/eudi-issuance-server/config/issuer_auth.json
services/eudi-issuance-server/config/reader_auth.json
services/eudi-issuance-server/config/akte_van_overlijden_issuer_auth.json
services/eudi-issuance-server/config/akte_van_overlijden_reader_auth.json

# IDE / tooling state
.omc/
.DS_Store

# Node
dashboard/node_modules/
dashboard/dist/

# Certs (generated)
certs/*.pem
certs/*.csr
certs/*.srl

# PKI material — regenerated per-user via bootstrap scripts.
# Certs (.pem/.der/.crt) and keys are useless without their matching
# private keys; keeping either in git only causes drift on every regen.
fsc-infra/orgs/*/pki/
fsc-infra/directory-peer/pki/
fsc-infra/directory-ui/pki/
fsc-infra/pki/ca/
services/pdp-service/certs/
services/openftv-pdp/certs/
# Preserve the input JSON templates + scripts that generate the above.
!fsc-infra/pki/*.json
!fsc-infra/pki/*.sh
