{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gov:nl:gbo:schema:gbo-source-metadata:1",
  "title": "GBO source metadata v1",
  "description": "Transport-neutral source capabilities published through the transport selected during GBO onboarding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_oin",
    "version",
    "issued_at",
    "expires_at",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "1.1 adds the asi capability."
    },
    "source_oin": {
      "type": "string",
      "pattern": "^[0-9]{20}$"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    }
  },
  "if": {
    "properties": {
      "schema_version": {
        "const": "1.0"
      }
    }
  },
  "then": {
    "properties": {
      "capabilities": {
        "not": {
          "required": [
            "asi"
          ]
        }
      }
    }
  },
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "eudi": {
          "$ref": "#/$defs/eudiCapability"
        },
        "asi": {
          "$ref": "#/$defs/asiCapability"
        }
      }
    },
    "eudiCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "attestations"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "attestations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attestation"
          }
        }
      }
    },
    "asiCapability": {
      "description": "Attributes the source offers for verification by GBO's attribute source interface provider (ETSI TS 119 478). GBO validates each mapping against the value_schema it keeps per attribute identifier.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "authentic_source",
        "graphql",
        "attributes"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "authentic_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "legal_name",
            "country"
          ],
          "properties": {
            "legal_name": {
              "type": "string",
              "minLength": 1
            },
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            }
          }
        },
        "graphql": {
          "$ref": "#/$defs/asiGraphql"
        },
        "attributes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/asiAttribute"
          }
        }
      }
    },
    "asiGraphql": {
      "description": "One query for the source. The document holds ...Selected exactly once; the ASIP replaces it with the fields the requested attributes need.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "document",
        "subject_variable",
        "result_pointer"
      ],
      "properties": {
        "service_reference": {
          "$ref": "#/$defs/graphql/properties/service_reference"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "subject_variable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "result_pointer": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "asiAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier",
        "fields"
      ],
      "properties": {
        "identifier": {
          "type": "string",
          "format": "uri"
        },
        "on": {
          "description": "GraphQL type the pointers apply to, when the result is an interface or union.",
          "$ref": "#/$defs/graphqlName"
        },
        "fields": {
          "description": "Per member of the attribute's value_schema, how the source's fields make it up.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/graphqlName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/asiField"
          }
        }
      }
    },
    "asiField": {
      "description": "Exactly one operation: copy a field, join fields, a fixed value, or per element of a list.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pointer"
          ],
          "properties": {
            "pointer": {
              "$ref": "#/$defs/fieldPointer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "join",
            "separator"
          ],
          "properties": {
            "join": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/fieldPointer"
              }
            },
            "separator": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "const"
          ],
          "properties": {
            "const": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "each",
            "pointer"
          ],
          "properties": {
            "each": {
              "$ref": "#/$defs/fieldPointer"
            },
            "pointer": {
              "$ref": "#/$defs/fieldPointer"
            }
          }
        }
      ]
    },
    "fieldPointer": {
      "description": "JSON Pointer (RFC 6901) whose segments are GraphQL field names; the ASIP derives the selection from it.",
      "type": "string",
      "pattern": "^(/[_A-Za-z][_0-9A-Za-z]*)+$"
    },
    "graphqlName": {
      "type": "string",
      "pattern": "^[_A-Za-z][_0-9A-Za-z]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_id",
        "type_version",
        "offers",
        "graphql",
        "mapping_profile",
        "display",
        "claims"
      ],
      "properties": {
        "type_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "type_version": {
          "$ref": "#/$defs/version"
        },
        "offers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/offer"
          }
        },
        "graphql": {
          "$ref": "#/$defs/graphql"
        },
        "mapping_profile": {
          "const": "gbo-simple-v1"
        },
        "display": {
          "description": "Card-level wallet presentation, keyed by language tag. GBO publishes it as Type Metadata display.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/languageTag"
          },
          "additionalProperties": {
            "$ref": "#/$defs/display"
          }
        },
        "claims": {
          "description": "Every credential claim, defined once and keyed by claim name. GBO derives the gbo-simple-v1 mapping and the Type Metadata claims and schema from it.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "propertyNames": {
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
              "enum": [
                "vct",
                "cnf",
                "iss",
                "nbf",
                "exp",
                "iat",
                "sub",
                "status",
                "attestation_qualification"
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "graphql": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "document",
        "subject_variable",
        "parameters",
        "result_pointer"
      ],
      "properties": {
        "service_reference": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "subject_variable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          }
        },
        "result_pointer": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "required"
      ],
      "properties": {
        "type": {
          "enum": [
            "integer",
            "string",
            "boolean",
            "date"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/languageTag"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "summary": {
          "type": "string",
          "description": "May reference claims as {{claim_name}}."
        },
        "rendering": {
          "type": "object"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "label"
      ],
      "properties": {
        "source": {
          "allOf": [
            {
              "$ref": "urn:gov:nl:gbo:schema:gbo-simple-v1:1#/$defs/rule"
            },
            {
              "description": "nl-wallet v0.5 cannot represent non-integral numbers.",
              "properties": {
                "datatype": {
                  "not": {
                    "const": "number"
                  }
                }
              }
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "sd": {
          "enum": [
            "always",
            "allowed",
            "never"
          ],
          "default": "always"
        }
      }
    }
  }
}
