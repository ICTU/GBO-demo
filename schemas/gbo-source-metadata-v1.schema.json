{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gov:nl:gbo:schema:gbo-source-metadata:1",
  "title": "GBO source metadata v1",
  "description": "Transport-neutral source capabilities published through the transport selected during GBO onboarding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_oin",
    "version",
    "issued_at",
    "expires_at",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "source_oin": {
      "type": "string",
      "pattern": "^[0-9]{20}$"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    }
  },
  "$defs": {
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "eudi": {
          "$ref": "#/$defs/eudiCapability"
        }
      }
    },
    "eudiCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "attestations"
      ],
      "properties": {
        "version": {
          "const": "1.0"
        },
        "attestations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/attestation"
          }
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_id",
        "type_version",
        "offers",
        "type_metadata",
        "graphql",
        "mapping_profile",
        "mapping",
        "attribute_schema"
      ],
      "properties": {
        "type_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "type_version": {
          "$ref": "#/$defs/version"
        },
        "offers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/offer"
          }
        },
        "type_metadata": {
          "$ref": "#/$defs/typeMetadata"
        },
        "graphql": {
          "$ref": "#/$defs/graphql"
        },
        "mapping_profile": {
          "const": "gbo-simple-v1"
        },
        "mapping": {
          "$ref": "urn:gov:nl:gbo:schema:gbo-simple-v1:1"
        },
        "attribute_schema": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 128,
          "propertyNames": {
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/attribute"
          }
        }
      }
    },
    "typeMetadata": {
      "type": "object",
      "required": [
        "name",
        "claims",
        "schema"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "display": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "schema": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "vct"
            ]
          }
        },
        {
          "not": {
            "required": [
              "vct#integrity"
            ]
          }
        }
      ]
    },
    "graphql": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "document",
        "subject_variable",
        "parameters",
        "result_pointer"
      ],
      "properties": {
        "service_reference": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "type": "string",
          "minLength": 1
        },
        "subject_variable": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          }
        },
        "result_pointer": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "required"
      ],
      "properties": {
        "type": {
          "enum": [
            "integer",
            "string",
            "boolean",
            "date"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 1024
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "attribute": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "string",
                "boolean",
                "integer",
                "number"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "format"
          ],
          "properties": {
            "type": {
              "const": "string"
            },
            "format": {
              "const": "date"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "format"
          ],
          "properties": {
            "type": {
              "const": "integer"
            },
            "format": {
              "const": "gYear"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "unit"
          ],
          "properties": {
            "type": {
              "const": "number"
            },
            "unit": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      ]
    }
  }
}
