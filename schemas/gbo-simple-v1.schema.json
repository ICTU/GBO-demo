{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gov:nl:gbo:schema:gbo-simple-v1:1",
  "title": "GBO simple mapping profile v1",
  "description": "Closed mapping contract for pointer-based scalar projection with optional exact money scaling.",
  "type": "object",
  "minProperties": 1,
  "maxProperties": 128,
  "propertyNames": {
    "maxLength": 64,
    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/rule"
  },
  "$defs": {
    "pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pointer", "datatype"],
      "properties": {
        "pointer": {
          "$ref": "#/$defs/pointer"
        },
        "datatype": {
          "enum": ["string", "boolean", "integer", "number", "date", "gYear"]
        },
        "transform": {
          "$ref": "#/$defs/moneyScale"
        }
      },
      "if": {
        "required": ["transform"]
      },
      "then": {
        "properties": {
          "datatype": {
            "const": "integer"
          }
        }
      }
    },
    "moneyScale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "currency_pointer",
        "currency",
        "source_scale",
        "target_scale"
      ],
      "properties": {
        "operator": {
          "const": "money_scale"
        },
        "currency_pointer": {
          "$ref": "#/$defs/pointer"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "source_scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "target_scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    }
  }
}
