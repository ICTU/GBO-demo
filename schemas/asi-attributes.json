{
  "attributes": [
    {
      "identifier": "https://gbo.example/attributes/family_name/1",
      "value_schema": {
        "type": "object",
        "properties": {
          "family_name": { "type": "string" }
        },
        "required": ["family_name"]
      }
    },
    {
      "identifier": "https://gbo.example/attributes/given_name/1",
      "value_schema": {
        "type": "object",
        "properties": {
          "given_name": { "type": "string" }
        },
        "required": ["given_name"]
      }
    },
    {
      "identifier": "https://gbo.example/attributes/birth_date/1",
      "value_schema": {
        "type": "object",
        "properties": {
          "birth_date": { "type": "string", "format": "date" }
        },
        "required": ["birth_date"]
      }
    },
    {
      "identifier": "https://gbo.example/attributes/nationality/1",
      "value_schema": {
        "type": "object",
        "properties": {
          "nationalities": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["nationalities"]
      }
    },
    {
      "identifier": "https://gbo.example/attributes/address/1",
      "value_schema": {
        "type": "object",
        "properties": {
          "street": { "type": "string" },
          "house_number": { "type": "string" },
          "postal_code": { "type": "string" },
          "city": { "type": "string" },
          "country": { "type": "string" }
        },
        "required": ["street", "house_number", "postal_code", "city", "country"]
      }
    }
  ]
}
