index 0000000..7be0d18
--- /dev/null
+++ b/core-logic/src/testDev/java/eu/europa/ec/corelogic/config/GboLoTEVerifierTest.kt
@@ -0,0 +1,23 @@
+package eu.europa.ec.corelogic.config
+
+import org.junit.Test
+import org.junit.Assert.assertThrows
+import java.time.Instant
+
+class GboLoTEVerifierTest {
+    private fun bytes(name: String) = checkNotNull(javaClass.getResourceAsStream("/gbo-lote/$name")).use { it.readBytes() }
+    private val now = Instant.parse("2026-11-11T12:00:00Z")
+    @Test fun signedGboListIsAccepted() {
+        GboLoTEVerifier(bytes("root.der")).verify(String(bytes("valid.jwt")), now)
+    }
+    @Test fun independentPinAndProfileAreRequired() {
+        val verifier = GboLoTEVerifier(bytes("root.der"))
+        for (name in listOf("eu-territory", "wrong-role", "expired", "future", "wrong-alg", "bad-signature")) {
+            assertThrows(Exception::class.java) { verifier.verify(String(bytes("$name.jwt")), now) }
+        }
+        assertThrows(Exception::class.java) { GboLoTEVerifier(bytes("wrong-root.der")).verify(String(bytes("valid.jwt")), now) }
+        for (malformed in listOf("", "a.b", "a.b.c", "..")) {
+            assertThrows(Exception::class.java) { verifier.verify(malformed, now) }
+        }
+    }
+}
