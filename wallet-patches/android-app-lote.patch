--- /dev/null
+++ b/core-logic/src/dev/java/eu/europa/ec/corelogic/config/GboTrust.kt
@@ -0,0 +1,20 @@
+package eu.europa.ec.corelogic.config
+
+import eu.europa.ec.corelogic.BuildConfig
+import eu.europa.ec.eudi.etsi119602.datamodel.Uri
+import eu.europa.ec.eudi.etsi1196x2.consultation.SupportedLists
+import java.util.Base64
+
+/** Endpoints and independent public scheme pin supplied per build variant. */
+internal object GboTrust {
+    const val NL_PID = "urn:eudi:pid:nl:1"
+    val issuerUrls = listOf("rvig", "belastingdienst", "demo-unsecured", "test-pid")
+        .map { "${BuildConfig.GBO_ISSUER_BASE_URL.trimEnd('/')}/$it/eudi" }
+    val locations = SupportedLists(
+        pidProviders = Uri("${BuildConfig.GBO_TRUST_BASE_URL.trimEnd('/')}/lote/PIDProviders.jwt"),
+        pubEaaProviders = Uri("${BuildConfig.GBO_TRUST_BASE_URL.trimEnd('/')}/lote/PubEAAProviders.jwt"),
+        wrpacProviders = Uri("${BuildConfig.GBO_TRUST_BASE_URL.trimEnd('/')}/lote/WRPACProviders.jwt"),
+        wrprcProviders = Uri("${BuildConfig.GBO_TRUST_BASE_URL.trimEnd('/')}/lote/WRPRCProviders.jwt"),
+    )
+    val verifier = GboLoTEVerifier(runCatching { Base64.getDecoder().decode(BuildConfig.GBO_LOTE_ROOT_BASE64) }.getOrDefault(byteArrayOf()))
+}
diff --git a/core-logic/src/dev/java/eu/europa/ec/corelogic/config/GboLoTEVerifier.kt b/core-logic/src/dev/java/eu/europa/ec/corelogic/config/GboLoTEVerifier.kt
new file mode 100644
index 0000000..ed9d393
--- /dev/null
+++ b/core-logic/src/dev/java/eu/europa/ec/corelogic/config/GboLoTEVerifier.kt
@@ -0,0 +1,74 @@
+package eu.europa.ec.corelogic.config
+
+import eu.europa.ec.eudi.etsi119602.consultation.VerifyJwtSignature
+import kotlinx.serialization.json.*
+import java.math.BigInteger
+import java.security.KeyFactory
+import java.security.Signature
+import java.security.cert.*
+import java.security.interfaces.ECPublicKey
+import java.time.Instant
+import java.util.Base64
+import java.util.Date
+
+/** GBO demo profile. x5c carries a chain, never the independently configured trust anchor. */
+internal class GboLoTEVerifier(private val rootDer: ByteArray) : VerifyJwtSignature {
+    override suspend fun invoke(jwt: String): VerifyJwtSignature.Outcome = try {
+        verify(jwt)
+        VerifyJwtSignature.Outcome.Verified(jwt)
+    } catch (e: Exception) {
+        VerifyJwtSignature.Outcome.NotVerified(e)
+    }
+
+    fun verify(jwt: String, now: Instant = Instant.now()) {
+        require(jwt.length <= 4 * 1024 * 1024)
+        val parts = jwt.split('.')
+        require(parts.size == 3)
+        val header = Json.parseToJsonElement(String(decode(parts[0]), Charsets.UTF_8)).jsonObject
+        require(header["alg"]?.jsonPrimitive?.content == "ES256" && "crit" !in header && "b64" !in header)
+        val factory = CertificateFactory.getInstance("X.509")
+        fun cert(bytes: ByteArray) = factory.generateCertificate(bytes.inputStream()) as X509Certificate
+        val root = cert(rootDer)
+        val chain = header.getValue("x5c").jsonArray.map { cert(Base64.getDecoder().decode(it.jsonPrimitive.content)) }
+        require(chain.size in 1..5 && !chain.first().encoded.contentEquals(rootDer))
+        require(chain.first().basicConstraints == -1)
+        chain.first().keyUsage?.let { require(it[0]) }
+        (chain + root).forEach { it.checkValidity(Date.from(now)) }
+        val path = factory.generateCertPath(chain.filterNot { it.encoded.contentEquals(rootDer) })
+        val params = PKIXParameters(setOf(TrustAnchor(root, null))).apply {
+            isRevocationEnabled = false // Explicit demo shortcut, like the existing GBO build.
+            date = Date.from(now)
+        }
+        CertPathValidator.getInstance("PKIX").validate(path, params)
+        val key = chain.first().publicKey as ECPublicKey
+        require(key.params.curve.field.fieldSize == 256)
+        val raw = decode(parts[2]); require(raw.size == 64)
+        fun integer(bytes: ByteArray): ByteArray {
+            val value = BigInteger(1, bytes).toByteArray()
+            return byteArrayOf(2, value.size.toByte()) + value
+        }
+        val rs = integer(raw.copyOfRange(0, 32)) + integer(raw.copyOfRange(32, 64))
+        val signature = byteArrayOf(0x30, rs.size.toByte()) + rs
+        require(Signature.getInstance("SHA256withECDSA").run {
+            initVerify(key); update((parts[0] + "." + parts[1]).toByteArray(Charsets.US_ASCII)); verify(signature)
+        })
+        val lote = Json.parseToJsonElement(String(decode(parts[1]), Charsets.UTF_8)).jsonObject.getValue("LoTE").jsonObject
+        val info = lote.getValue("ListAndSchemeInformation").jsonObject
+        fun value(name: String) = info.getValue(name).jsonPrimitive.content
+        require(value("SchemeTerritory") == "NL" && value("LoTEVersionIdentifier") == "1" && value("LoTESequenceNumber").toLong() > 0)
+        require(info.getValue("SchemeOperatorName").jsonArray.any { it.jsonObject["value"]?.jsonPrimitive?.content == "GBO Demo" })
+        val role = listOf("PID", "PubEAA", "WRPAC", "WRPRC").single { value("LoTEType") == "http://uri.etsi.org/19602/LoTEType/EU${it}ProvidersList" }
+        val issue = Instant.parse(value("ListIssueDateTime")); val until = Instant.parse(value("NextUpdate"))
+        require(!issue.isAfter(now) && now.isBefore(until) && issue.isBefore(until))
+        val entities = lote.getValue("TrustedEntitiesList").jsonArray; require(entities.isNotEmpty())
+        entities.forEach { entity ->
+            val services = entity.jsonObject.getValue("TrustedEntityServices").jsonArray; require(services.isNotEmpty())
+            services.forEach {
+                val type = it.jsonObject.getValue("ServiceInformation").jsonObject.getValue("ServiceTypeIdentifier").jsonPrimitive.content
+                require(type in listOf("Issuance", "Revocation").map { purpose -> "http://uri.etsi.org/19602/SvcType/$role/$purpose" })
+            }
+        }
+    }
+
+    private fun decode(value: String): ByteArray = Base64.getUrlDecoder().decode(value)
+}
