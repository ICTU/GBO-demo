        "https://gbo.example/attributes/given_name/1": "given_name",
        "https://gbo.example/attributes/birth_date/1": "birth_date",
        "https://gbo.example/attributes/nationality/1": "nationality",
        "https://gbo.example/attributes/address/1": "address"
      }
    }
  ]
