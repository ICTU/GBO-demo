{
  "valid_mappings": [
    {
      "name": "copy rename flatten and exact money",
      "mapping": {
        "full_name": {"pointer": "/person/name", "datatype": "string"},
        "active": {"pointer": "/person/active", "datatype": "boolean"},
        "birth_date": {"pointer": "/person/birth/date", "datatype": "date"},
        "year": {"pointer": "/year", "datatype": "gYear"},
        "amount_minor": {
          "pointer": "/amount/value",
          "datatype": "integer",
          "transform": {
            "operator": "money_scale",
            "currency_pointer": "/amount/currency",
            "currency": "EUR",
            "source_scale": 2,
            "target_scale": 2
          }
        }
      }
    }
  ],
  "invalid_mappings": [
    {
      "name": "filter operator is not part of the profile",
      "mapping": {"claim": {"pointer": "/value", "datatype": "string", "filter": "first"}},
      "error_code": "GBO_SIMPLE_MAPPING_INVALID"
    },
    {
      "name": "sorting is not part of the profile",
      "mapping": {"claim": {"pointer": "/value", "datatype": "string", "sort": "ascending"}},
      "error_code": "GBO_SIMPLE_MAPPING_INVALID"
    },
    {
      "name": "first selection is not part of the profile",
      "mapping": {"claim": {"pointer": "/value", "datatype": "string", "first": true}},
      "error_code": "GBO_SIMPLE_MAPPING_INVALID"
    },
    {
      "name": "joins are not part of the profile",
      "mapping": {"claim": {"pointer": "/value", "datatype": "string", "join": "/other"}},
      "error_code": "GBO_SIMPLE_MAPPING_INVALID"
    },
    {
      "name": "conditionals are not part of the profile",
      "mapping": {"claim": {"pointer": "/value", "datatype": "string", "if": "present"}},
      "error_code": "GBO_SIMPLE_MAPPING_INVALID"
    },
    {
      "name": "scripts are not part of the profile",
      "mapping": {"claim": {"pointer": "/value", "datatype": "string", "script": "return value"}},
      "error_code": "GBO_SIMPLE_MAPPING_INVALID"
    },
    {
      "name": "external IO is not part of the profile",
      "mapping": {"claim": {"pointer": "/value", "datatype": "string", "url": "https://example.invalid"}},
      "error_code": "GBO_SIMPLE_MAPPING_INVALID"
    },
    {
      "name": "unknown transform operator",
      "mapping": {
        "claim": {
          "pointer": "/value",
          "datatype": "integer",
          "transform": {
            "operator": "round",
            "currency_pointer": "/currency",
            "currency": "EUR",
            "source_scale": 2,
            "target_scale": 0
          }
        }
      },
      "error_code": "GBO_SIMPLE_CONVERSION_UNSUPPORTED"
    },
    {
      "name": "invalid pointer escape",
      "mapping": {"claim": {"pointer": "/bad~2pointer", "datatype": "string"}},
      "error_code": "GBO_SIMPLE_MAPPING_INVALID"
    },
    {
      "name": "money transform requires integer output",
      "mapping": {
        "claim": {
          "pointer": "/value",
          "datatype": "number",
          "transform": {
            "operator": "money_scale",
            "currency_pointer": "/currency",
            "currency": "EUR",
            "source_scale": 2,
            "target_scale": 0
          }
        }
      },
      "error_code": "GBO_SIMPLE_MAPPING_INVALID"
    }
  ],
  "projections": [
    {
      "name": "valid scalar and exact money projection",
      "input": {"data": {"rows": [{"person": {"name": "Ada", "active": true, "birth": {"date": "1815-12-10"}}, "year": 2025, "amount": {"value": 43.50, "currency": "EUR"}}]}},
      "result_pointer": "/data/rows",
      "mapping_ref": "copy rename flatten and exact money",
      "outcome": "credential",
      "claims": {"full_name": "Ada", "active": true, "birth_date": "1815-12-10", "year": 2025, "amount_minor": 4350}
    },
    {
      "name": "no rows is no data",
      "input": {"data": {"rows": []}},
      "result_pointer": "/data/rows",
      "mapping_ref": "copy rename flatten and exact money",
      "outcome": "no_data"
    },
    {
      "name": "multiple rows are ambiguous",
      "input": {"data": {"rows": [{}, {}]}},
      "result_pointer": "/data/rows",
      "mapping_ref": "copy rename flatten and exact money",
      "error_code": "GBO_SIMPLE_CARDINALITY_AMBIGUOUS"
    },
    {
      "name": "missing claim path",
      "input": {"data": {"rows": [{"person": {"active": true}}]}},
      "result_pointer": "/data/rows",
      "mapping": {"claim": {"pointer": "/missing", "datatype": "string"}},
      "error_code": "GBO_SIMPLE_PATH_MISSING"
    },
    {
      "name": "wrong scalar type",
      "input": {"data": {"rows": [{"value": "42"}]}},
      "result_pointer": "/data/rows",
      "mapping": {"claim": {"pointer": "/value", "datatype": "integer"}},
      "error_code": "GBO_SIMPLE_TYPE_MISMATCH"
    },
    {
      "name": "currency mismatch",
      "input": {"data": {"rows": [{"amount": {"value": 42.00, "currency": "USD"}}]}},
      "result_pointer": "/data/rows",
      "mapping": {
        "claim": {
          "pointer": "/amount/value",
          "datatype": "integer",
          "transform": {"operator": "money_scale", "currency_pointer": "/amount/currency", "currency": "EUR", "source_scale": 2, "target_scale": 0}
        }
      },
      "error_code": "GBO_SIMPLE_CURRENCY_MISMATCH"
    },
    {
      "name": "inexact whole-euro conversion",
      "input": {"data": {"rows": [{"amount": {"value": 43000.50, "currency": "EUR"}}]}},
      "result_pointer": "/data/rows",
      "mapping": {
        "claim": {
          "pointer": "/amount/value",
          "datatype": "integer",
          "transform": {"operator": "money_scale", "currency_pointer": "/amount/currency", "currency": "EUR", "source_scale": 2, "target_scale": 0}
        }
      },
      "error_code": "GBO_SIMPLE_MONEY_INEXACT"
    }
  ]
}
