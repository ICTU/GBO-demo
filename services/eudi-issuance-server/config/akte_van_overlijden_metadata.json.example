      ],
      "sd": "always"
    },
    {
      "path": ["overledene_geboorteland"],
      "display": [
        { "lang": "nl-NL", "label": "Geboorteland overledene", "description": "Land waar de overledene is geboren (ISO 3166-1 alpha-2)" },
        { "lang": "en-US", "label": "Country of birth of the deceased", "description": "Country where the deceased was born (ISO 3166-1 alpha-2)" }
      ],
      "sd": "always"
    },
    {
