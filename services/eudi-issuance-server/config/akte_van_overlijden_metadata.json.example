{
  "vct": "nl.gbo.brp.akte-van-overlijden",
  "name": "Akte van overlijden",
  "description": "Uittreksel overlijdensgegevens van de huwelijkspartner uit de Basisregistratie Personen (BRP)",
  "display": [
    {
      "lang": "nl-NL",
      "name": "Akte van overlijden",
      "description": "Overlijdensgegevens van de huwelijkspartner (BRP)",
      "summary": "{{overledene_voornamen}} {{overledene_geslachtsnaam}} ({{datum_overlijden}})",
      "rendering": {
        "simple": {
          "background_color": "#3b3b46",
          "text_color": "#ffffff"
        }
      }
    },
    {
      "lang": "en-US",
      "name": "Death certificate",
      "description": "Death record of the spouse (Dutch Personal Records Database)",
      "summary": "{{overledene_voornamen}} {{overledene_geslachtsnaam}} ({{datum_overlijden}})",
      "rendering": {
        "simple": {
          "background_color": "#3b3b46",
          "text_color": "#ffffff"
        }
      }
    }
  ],
  "claims": [
    {
      "path": ["overledene_geslachtsnaam"],
      "display": [
        { "lang": "nl-NL", "label": "Geslachtsnaam overledene", "description": "Officiële familienaam van de overledene" },
        { "lang": "en-US", "label": "Surname of the deceased", "description": "Official family name of the deceased" }
      ],
      "sd": "always",
      "svg_id": "overledene_geslachtsnaam"
    },
    {
      "path": ["overledene_voorvoegsel"],
      "display": [
        { "lang": "nl-NL", "label": "Voorvoegsel overledene", "description": "Voorvoegsel bij de geslachtsnaam van de overledene" },
        { "lang": "en-US", "label": "Name prefix of the deceased", "description": "Prefix belonging to the surname of the deceased" }
      ],
      "sd": "always"
    },
    {
      "path": ["overledene_voornamen"],
      "display": [
        { "lang": "nl-NL", "label": "Voornamen overledene", "description": "Alle officiële voornamen van de overledene" },
        { "lang": "en-US", "label": "Given names of the deceased", "description": "All official given names of the deceased" }
      ],
      "sd": "always"
    },
    {
      "path": ["overledene_geboortedatum"],
      "display": [
        { "lang": "nl-NL", "label": "Geboortedatum overledene", "description": "Datum waarop de overledene is geboren" },
        { "lang": "en-US", "label": "Date of birth of the deceased", "description": "Date on which the deceased was born" }
      ],
      "sd": "always"
    },
    {
      "path": ["overledene_geboorteplaats"],
