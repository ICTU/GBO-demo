      "nabestaande_geslachtsnaam": { "type": "string" },
      "nabestaande_voorvoegsel":   { "type": "string" },
      "nabestaande_voornamen":     { "type": "string" },
      "verklaring_tekst":          { "type": "string" }
    },
    "required": ["vct", "iss", "attestation_qualification", "overledene_geslachtsnaam", "datum_overlijden"]
